# Template only — never put real credentials here, this file IS committed.
# Copy to `.env` (gitignored) and fill that in instead. Shell exports override both.
# Verify with: python scripts/check_llm.py

# Note the https:// — the server 301-redirects plain http, and a redirected
# POST silently loses its body. The trailing /v1 is optional.
GMS_LLM_BASE_URL=https://your-vllm-host.example/

# An id from the server's /v1/models — check_llm.py prints the list. If your
# deployment serves role aliases rather than model names, record what the alias
# actually resolves to before publishing numbers: an alias can be repointed
# without notice, which silently breaks the fixed-extraction-model control.
GMS_LLM_MODEL=local-main

# Required: the server rejects unauthenticated requests with 401.
GMS_LLM_API_KEY=

# local-main is a reasoning model whose thinking is billed against max_tokens;
# leaving it on made extraction prompts exhaust the budget and return null
# content. Unset this for models that reject chat_template_kwargs (400).
GMS_LLM_ENABLE_THINKING=false

# Judge for factual correctness. Keep it different from GMS_LLM_MODEL: a model
# grading its own output inflates Answer Accuracy. Latency ordering between two
# served models can invert by workload, so measure per workload rather than
# assuming the faster extractor is also the faster judge.
GMS_JUDGE_MODEL=local-critic
